{
  "manifest_version": 3,
  "name": "BookBrain Clipper",
  "version": "0.2.2",
  "description": "Save the current page to BookBrain and quickly open your daily bookmarks.",
  "permissions": ["activeTab", "contextMenus", "storage", "alarms"],
  "host_permissions": [
    "http://book.agiwish.com/*",
    "https://book.agiwish.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Save to BookBrain",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "save-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "Save current page to BookBrain"
    }
  },
  "options_page": "options.html"
}
